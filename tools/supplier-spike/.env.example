# Copiar como .env (ese archivo NO se sube a GitHub) y completar.

# Dirección exacta de la página donde ingresás con usuario y clave
SUPPLIER_PORTAL_URL=https://portal-del-proveedor.com/login

# Tus datos de ingreso (en Chrome: chrome://password-manager/passwords)
SUPPLIER_USER=
SUPPLIER_PASSWORD=

# Páginas a recorrer después del ingreso, separadas por coma (rutas relativas al portal)
SUPPLIER_PATHS=/comprar,/usuario/lista-precios

# false = se ve la ventana del navegador mientras trabaja (recomendado la primera vez)
HEADLESS=false
